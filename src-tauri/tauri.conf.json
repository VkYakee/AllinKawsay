{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Allin Kawsay",
  "version": "3.0.0",
  "identifier": "com.allinkawsay.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Allin Kawsay",
        "width": 400,
        "height": 800,
        "resizable": false,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#0A0A0A"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../assets/zampona/*"],
    "android": {
      "minSdkVersion": 26
    }
  }
}